{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Azure": {
    "SubscriptionId": "{your-azure-subscription-id}",
    "AllowResourceGroupCreation": false,
    "ResourceGroup": "rg-ga2025-tenerife",
    "Location": "spaincentral",
    "CredentialSource": "AzureCli"
  },
  "Parameters": {
    "resource-group-name": "rg-ga2025-tenerife",
    "sql-server-name": "sql-dragonball",
    "key-vault-name": "kv-dragonball",
    "app-configuration-name": "appcs-dragonball",
    "storage-name": "stdragonball"
  },
  "ConnectionStrings": {
    "sql-dragonball": "Server=tcp:{your-sql-server}.database.windows.net,1433;Initial Catalog={your-database};Persist Security Info=False;User ID={your-username};Password={your-password};MultipleActiveResultSets=False;Encrypt=True;TrustServerCertificate=False;Connection Timeout=30;"
  }
}
